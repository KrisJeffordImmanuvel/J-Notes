{
  "name": "j-notes",
  "version": "1.1.0",
  "private": true,
  "description": "J Notes — a private, local-first notes and diary app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "build:all": "npm run build && npm run build:single && node scripts/copy-single.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.js",
    "lint": "eslint src build scripts tests"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.0.0"
  }
}
