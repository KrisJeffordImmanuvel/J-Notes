# Google OAuth client ID (Web application) for "Continue with Google" sync.
# See README → Google sign-in and sync. Copy to .env.local and fill in.
VITE_GOOGLE_CLIENT_ID=
# SHA-256 of the owner's lower-case Gmail address — turns on personal mode (only that account, PIN always on).
# printf '%s' 'you@gmail.com' | sha256sum
VITE_OWNER_EMAIL_HASH=
